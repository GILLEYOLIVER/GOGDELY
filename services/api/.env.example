# Modelo de variáveis de ambiente da API GOGDELY.
# Copie para .env em ambientes gerenciados; nunca comite valores reais.

# local | test | homolog | production
GOGDELY_ENV=local

# Fluxo de demonstração local (SQLite). Desativar fora do laboratório.
GOGDELY_LOCAL_DEMO=1

# Caminho do SQLite do laboratório local.
GOGDELY_LOCAL_DB=.local/gogdely.sqlite3

# Conexão de banco gerenciado futuro (Supabase PostgreSQL ou outro).
# Ex.: postgresql://usuario:senha@host:5432/gogdely — apenas via secret.
GOGDELY_DATABASE_URL=

# Origens extras permitidas no CORS para frontends hospedados.
# Ex.: https://app.gogdely.com.br
GOGDELY_CORS_ORIGINS=
