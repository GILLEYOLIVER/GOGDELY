{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GOGDELY API (FastAPI local)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["gogdely_api.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/services/api",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GOGDELY Cliente • Laboratório (Chrome)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/cliente",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": ["--dart-define=GOGDELY_LAB=true"]
    },
    {
      "name": "GOGDELY Cliente • Flutter (dispositivo)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/cliente",
      "program": "lib/main.dart"
    }
  ]
}
